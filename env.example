# Chave de API da IBM Cloud
WATSONX_API_KEY=sua_api_key_aqui

# ID do projeto no IBM watsonx.ai
WATSONX_PROJECT_ID=seu_project_id_aqui

# URL da instância watsonx.ai
WATSONX_URL=https://us-south.ml.cloud.ibm.com
